#!/usr/bin/env sh
# Start the OmaMessenger helper: a local development build when present
# (bin/dev/, from `make build`), otherwise the pinned release installed by
# scripts/install-helper.sh. Exit status 3 means no helper is installed.
set -eu

plugin_dir=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
dev_helper="$plugin_dir/bin/dev/oma-messenger-service"
if [ -x "$dev_helper" ]; then
    exec "$dev_helper" "$@"
fi

# helper-version carries a trailing "# x-release-please-version" comment
# that release-please's generic updater matches on; cut it before the
# comment, then trim the rest.
version=$(cut -d'#' -f1 "$plugin_dir/helper-version" | tr -d ' \n')
helper="${XDG_DATA_HOME:-$HOME/.local/share}/omamessenger/bin/oma-messenger-service-$version"
if [ -x "$helper" ]; then
    exec "$helper" "$@"
fi

printf 'OmaMessenger helper %s is not installed. Opening the window installs it, or run scripts/install-helper.sh by hand.\n' "$version" >&2
exit 3
