#!/bin/sh
# Rejects a commit whose first line is not a Conventional Commit
# (type(scope)!: summary), per .claude/rules/workflow.md. `make
# install-hooks` points git at this directory with `git config
# core.hooksPath hooks`; git then runs this script itself, passing the
# commit message file's path as $1.
set -eu

msg_file=$1
subject=$(head -n 1 "$msg_file")

# Merge commits and fixup/squash markers carry their own subject line,
# never a type a contributor chose.
case "$subject" in
    "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

types='feat|fix|perf|refactor|test|docs|ci|build|chore'
if ! printf '%s\n' "$subject" | grep -Eq "^(${types})(\([a-zA-Z0-9_.-]+\))?!?: .+"; then
    printf 'commit-msg: "%s" is not a Conventional Commit\n' "$subject" >&2
    printf 'Expected: type(scope): summary, with type one of: feat fix perf refactor test docs ci build chore\n' >&2
    exit 1
fi
